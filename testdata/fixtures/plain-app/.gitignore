# Where this repository's worktrees live (wt.yaml worktrees.path): trees
# inside the repository are untracked content in the main checkout, and
# the create skill's pre-flight requires a clean status.
/.claude/worktrees/
# The worktree allocation record — generated by wt init (05-delivery §2.2).
wt-env.json
# The managed .env block — per-worktree allocation values (emit.env).
.env
# The build hook's output and the start hook's log.
plain-app-server
wt-server.log
