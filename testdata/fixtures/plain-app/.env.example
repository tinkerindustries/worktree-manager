# The shape of plain-app's .env. A first `init` seeds a worktree's .env from
# the main checkout's, copying unmanaged content only — managed keys come
# from the worktree's own allocation (05-delivery §3.3).
API_PORT=8080
DB_PATH=$HOME/.plain-app/db.sqlite
CACHE_PATH=$HOME/.plain-app/cache/
GITHUB_TOKEN=
